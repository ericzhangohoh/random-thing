  "old_register_sha256": "80e9e581927f4483cf99a3038dea6fb387ba9a903edec7b9b36cd69b8e940e7e",
  "new_source_sha256": "2c86588b978e271eaafae26f89a4adada724316981586051f5566d509c610685",
  "new_pdf_sha256": "4b9457da90c3b7a91343a0570fe1072a5bd5f7ff52aa36ecae10d80b687c3ff4",
  "new_register_sha256": "ef5ac7a999d90934b0e686cc0b36c80f6a69d6686f105f9c7431537b64c73f33",
  "changed_or_added": [
    {
      "id": "SUM02.04",
      "kind": "changed",
      "old_sentence": "We retain D as the prespecified selection without treating it as a universal future winner.",
      "new_sentence": "We retain D as the choice under the prespecified rule without treating it as a universal future winner.",
      "old_source_line": 44,
      "new_source_line": 44
    },
    {
      "id": "SUM04.03",
      "kind": "changed",
      "old_sentence": "The dates describe where a conditional annual curve crosses each level, rather than realized or sustained warming or Paris targets.",
      "new_sentence": "These are first crossing dates on a conditional annual curve, not dates of realized or sustained warming or Paris-target crossings.",
      "old_source_line": 54,
      "new_source_line": 54
    },
    {
      "id": "SUM06.01",
      "kind": "changed",
      "old_sentence": "Concentration and temperature are strongly associated at level, but the association weakens after trend removal and differencing.",
      "new_sentence": "Concentration and temperature are strongly associated in their observed levels, but the association weakens after trend removal and differencing.",
      "old_source_line": 55,
      "new_source_line": 55
    },
    {
      "id": "SUM05.02",
      "kind": "changed",
      "old_sentence": "A range based on earlier temperature errors misses the 2016 observation, and 2031 is merely the corresponding ten-year display cutoff from 2021.",
      "new_sentence": "A range based on earlier temperature errors misses the 2016 observation.",
      "old_source_line": 56,
      "new_source_line": 56
    },
    {
      "id": "SUM05.02a",
      "kind": "added",
      "old_sentence": null,
      "new_sentence": "Separately, 2031 is the display cutoff obtained by extending the tested ten-year horizon from 2021.",
      "new_source_line": 56
    },
    {
      "id": "DAT07.01",
      "kind": "added",
      "old_sentence": null,
      "new_sentence": "These retrospective tests truncate one supplied data vintage by observation year.",
      "new_source_line": 65
    },
    {
      "id": "DAT07.02",
      "kind": "added",
      "old_sentence": null,
      "new_sentence": "They do not reconstruct the data releases actually available at each historical forecast origin.",
      "new_source_line": 65
    },
    {
      "id": "VAL01.01",
      "kind": "changed",
      "old_sentence": "For development, each rule is fitted using observations available through 1981, 1986, 1991, 1996 and 2001, then predicts the following one to ten years.",
      "new_sentence": "For development, each rule is fitted to observations in the supplied workbook dated no later than 1981, 1986, 1991, 1996 or 2001, then predicts the following one to ten years from that origin.",
      "old_source_line": 131,
      "new_source_line": 132
    },
    {
      "id": "VAL03.03",
      "kind": "changed",
      "old_sentence": "The local computation preserves this order, but another reviewer had already exposed the final-period scores before the primary selection receipt.",
      "new_sentence": "The local computation preserves this order, but another reviewer had already exposed the final-period scores before the primary run recorded its selection.",
      "old_source_line": 137,
      "new_source_line": 138
    },
    {
      "id": "TEM03.01",
      "kind": "changed",
      "old_sentence": "At each origin, T1 is fitted to the observed concentration–temperature pairs available by that date.",
      "new_sentence": "At each origin, T1 is fitted to concentration–temperature pairs in the supplied workbook dated no later than that origin.",
      "old_source_line": 177,
      "new_source_line": 178
    },
    {
      "id": "TEM05.03",
      "kind": "changed",
      "old_sentence": "Calling T1-D the global minimum would therefore misrepresent the results.",
      "new_sentence": "T1-D is the selected sequential pipeline, while T1-Q is the lowest-error declared temperature comparator.",
      "old_source_line": 192,
      "new_source_line": 193
    },
    {
      "id": "FC05.02",
      "kind": "changed",
      "old_sentence": "The left panel includes the accepted log-concentration fit, while the right uses changes read from the accepted diagnostic series.",
      "new_sentence": "The left panel shows the fitted log-concentration relationship, while the right shows annual changes in log concentration and temperature anomaly.",
      "old_source_line": 212,
      "new_source_line": 213
    },
    {
      "id": "REL02.02",
      "kind": "changed",
      "old_sentence": "The contrast is visible in Figure 5.",
      "new_sentence": "Table 8 gives the detrended comparisons, while Figure 5 contrasts observed levels with annual changes.",
      "old_source_line": 225,
      "new_source_line": 226
    },
    {
      "id": "SEN02.04",
      "kind": "changed",
      "old_sentence": "They are not a new optimized model or probability bounds.",
      "new_sentence": "These results neither select a replacement model nor provide probability bounds.",
      "old_source_line": 275,
      "new_source_line": 276
    },
    {
      "id": "APP01.02",
      "kind": "changed",
      "old_sentence": "Each concentration model has few parameters, historical forecasts respect the observations available at their origin, and temperature scores include upstream concentration forecast error.",
      "new_sentence": "Each concentration model has few parameters, historical fits use only workbook observations dated no later than their origin, and temperature scores include upstream concentration forecast error.",
      "old_source_line": 277,
      "new_source_line": 278
    },
    {
      "id": "APP02.05",
      "kind": "changed",
      "old_sentence": "A logistic capacity is not identified by the rising record, and a physical carbon-cycle or energy-balance model would require inputs absent from the two supplied series.",
      "new_sentence": "The supplied record does not establish a physically justified saturation capacity, and a physical carbon-cycle or energy-balance model would require additional inputs absent from these two series.",
      "old_source_line": 278,
      "new_source_line": 279
    },
    {
      "id": "APP04.03",
      "kind": "changed",
      "old_sentence": "Already-above-origin and valid non-crossing-through-2300 cases receive different statuses.",
      "new_sentence": "Paths already above the threshold at the forecast origin are distinguished from valid paths that do not cross it by 2300.",
      "old_source_line": 281,
      "new_source_line": 282
    },
    {
      "id": "APP04.05",
      "kind": "changed",
      "old_sentence": "None of the actual primary paths requires such a rescue.",
      "new_sentence": "All actual primary paths remain valid throughout the search domain.",
      "old_source_line": 281,
      "new_source_line": 282
    },
    {
      "id": "ART05.04",
      "kind": "changed",
      "old_sentence": "They describe conditional annual paths, not established deadlines, sustained warming dates or Paris targets.",
      "new_sentence": "These are crossing dates on conditional annual paths, not established deadlines, sustained warming dates or Paris targets.",
      "old_source_line": 294,
      "new_source_line": 295
    }
  ],
